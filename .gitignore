# IPTV playlists. Every stream URL in a real playlist embeds the provider
# username/password, and tools/web-player/ is published publicly by the SWA
# deploy workflow. Only the credential-free sample is allowed through.
*.m3u
*.m3u8
!tools/web-player/sample-playlist.m3u
tmp/
